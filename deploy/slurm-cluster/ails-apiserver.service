# AILS HPC Slurm Manager API server (apiserver) — systemd unit.
#
# 由 deploy/slurm-cluster/deploy_web_portal.sh 安装到 /etc/systemd/system/。
# 运行为专用系统用户 ails；EnvironmentFile 提供 AILS_JWT_SECRET 等（fail-closed，缺则拒启）。
# Type=notify：apiserver 通过 sd_notify 发 READY=1（systemctl start 据此判定就绪，取代 ExecStartPost 轮询）；
# 之后每 10s 发 WATCHDOG=1，WatchdogSec=30 下若停跳则 systemd 自动重启（覆盖"进程在但僵死"）。
#
# 常用：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ails-apiserver
#   sudo systemctl restart ails-apiserver
#   sudo systemctl status ails-apiserver
#   sudo journalctl -u ails-apiserver -f
# 端口改 AILS_PORT：把 ExecStart 的 -port 与 ExecStartPost 的探活端口一起改（后续可统一读环境变量）。

[Unit]
Description=AILS HPC Slurm Manager API server
Documentation=file:///opt/slurm-cluster/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
WatchdogSec=30
User=ails
Group=ails
WorkingDirectory=/opt/slurm-cluster
EnvironmentFile=/opt/slurm-cluster/.env
ExecStart=/opt/slurm-cluster/bin/apiserver -port 8090
Restart=on-failure
RestartSec=2
# 硬化：apiserver 原则上不写磁盘（slog→stdout→journald，仅读 .env + users.yaml）。
# 唯一可写目录 = sqlite 用户库（多租户 Phase 2 起：改密/禁用写 var/lib/ails/ails.db；
# yaml 种子文件保持只读——改密在 yaml 模式下会被明确拒绝而非半途失败）。
# 保留对外网络以连 slurmrestd（不加 PrivateNetwork）。
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/slurm-cluster/var/lib/ails
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
