else
  export NODE_PATH="/home/nilpo/ails-hpc/node_modules/.pnpm/nitropack@2.13.4_@parcel+watcher@2.6.0_srvx@0.11.22_vite@5.1.4_@types+node@20.19.43_terser@5.49.1_/node_modules/nitropack/node_modules:/home/nilpo/ails-hpc/node_modules/.pnpm/nitropack@2.13.4_@parcel+watcher@2.6.0_srvx@0.11.22_vite@5.1.4_@types+node@20.19.43_terser@5.49.1_/node_modules:/home/nilpo/ails-hpc/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -n "$exe" ] && [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe"  "$basedir_win/../../dist/cli/index.mjs" "$@"
elif [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../dist/cli/index.mjs" "$@"
elif command -v node >/dev/null 2>&1; then
